&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    AUTO_BASIS RI_HFX MEDIUM
    WFN_RESTART_FILE_NAME Nitrosomethane_PBE0_GS-RESTART.wfn
    UKS T
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 17
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &MOM
         MOM_TYPE IMOM
         DEOCC_BETA 12
         OCC_BETA 13
      &END MOM
    &END SCF
    &XC
      &HF
        &SCREENING
          EPS_SCHWARZ 1.0E-10
        &END SCREENING
        &MEMORY
          MAX_MEMORY 2000
        &END MEMORY
        &RI T
          ! Diffuse (aug) functions make the RI basis ill-conditioned for the
          ! default Cholesky decomposition.
          2C_MATRIX_FUNCTIONS DIAG
        &END RI
      &END HF
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  -0.94419297 0.00000000 -0.56740524
      N  -0.00286683 0.00000000 0.57183096
      O  1.15791903 0.00000000 0.22993880
      H  -0.40928669 0.00000000 -1.51564611
      H  -1.57415127 0.88267715 -0.45733920
      H  -1.57415127 -0.88267715 -0.45733920
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND O
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Nitrosomethane_PBE0_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
