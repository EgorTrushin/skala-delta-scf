&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Molecule4_R2SCAN_GS-RESTART.wfn
    UKS T
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 49
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      CHOLESKY OFF
      EPS_EIGVAL 1e-6
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.1
      &END MIXING
      &MOM
         MOM_TYPE IMOM
         DEOCC_BETA 44
         OCC_BETA 45
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &MGGA_X_R2SCAN
        &END MGGA_X_R2SCAN
        &MGGA_C_R2SCAN
        &END MGGA_C_R2SCAN
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 1.39188565
      C  0.00000000 0.00000000 -2.76599417
      C  0.00000000 -1.21792388 -0.69273656
      C  0.00000000 1.21792388 -0.69273656
      C  0.00000000 -1.20313869 -2.08296814
      C  0.00000000 1.20313869 -2.08296814
      C  0.00000000 -2.26567732 1.30886150
      C  0.00000000 2.26567732 1.30886150
      N  0.00000000 0.00000000 -0.01940584
      N  0.00000000 -2.37860356 -0.00383217
      N  0.00000000 2.37860356 -0.00383217
      N  0.00000000 -1.15425058 2.04921522
      N  0.00000000 1.15425058 2.04921522
      H  0.00000000 -2.15517594 -2.58041621
      H  0.00000000 2.15517594 -2.58041621
      H  0.00000000 -3.19217490 1.86393056
      H  0.00000000 3.19217490 1.86393056
      H  0.00000000 0.00000000 -3.84375807
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Molecule4_R2SCAN_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
