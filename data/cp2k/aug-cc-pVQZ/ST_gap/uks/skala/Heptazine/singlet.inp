&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Heptazine_SKALA_GS-RESTART.wfn
    UKS T
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 49
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &MOM
         MOM_TYPE IMOM
         DEOCC_BETA 44
         OCC_BETA 45
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          SKALA_RUNTIME MPI
          INT_EXECUTION_SPACE HOST
          GRID FINE
          PRUNING_SCHEME ROBUST
          RADIAL_QUADRATURE MURAKNOWLES
          MODEL_ATOM_CHUNK_SIZE 1
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 -1.21026832 0.69874874
      C  0.00000000 -2.25409077 -1.30139992
      C  0.00000000 0.00000000 -1.39749748
      C  0.00000000 2.25409077 -1.30139992
      C  0.00000000 1.21026832 0.69874874
      C  0.00000000 0.00000000 2.60279983
      N  0.00000000 0.00000000 0.00000000
      N  0.00000000 -2.35681119 0.02353328
      N  0.00000000 1.15802518 -2.05282500
      N  0.00000000 1.19878601 2.02929172
      N  0.00000000 -1.19878601 2.02929172
      N  0.00000000 -1.15802518 -2.05282500
      N  0.00000000 2.35681119 0.02353328
      H  0.00000000 3.18888962 -1.84110628
      H  0.00000000 0.00000000 3.68221256
      H  0.00000000 -3.18888962 -1.84110628
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Heptazine_SKALA_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
