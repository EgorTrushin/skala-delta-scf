&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Cyclazine_PBE_ROKS_TRIPLET-RESTART.wfn
    ROKS T
    MULTIPLICITY 3
    &LOW_SPIN_ROKS
      ! Variational singlet energy: 2 E(M) - E(T), at shared orbitals.
      ENERGY_SCALING -2 2
      SPIN_CONFIGURATION 1 1
      SPIN_CONFIGURATION 1 2
    &END LOW_SPIN_ROKS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 45
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &OT
        MINIMIZER DIIS
        STEPSIZE 0.005
        N_HISTORY_VEC 20
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 -1.21509585 0.70153592
      C  0.00000000 -2.42035519 -1.39739272
      C  0.00000000 0.00000000 -1.40307183
      C  0.00000000 2.42035519 -1.39739272
      C  0.00000000 1.21509585 0.70153592
      C  0.00000000 0.00000000 2.79478544
      C  0.00000000 -2.42010888 -0.01852722
      C  0.00000000 1.22609949 -2.08661215
      C  0.00000000 1.19400939 2.10513938
      C  0.00000000 -1.19400939 2.10513938
      C  0.00000000 -1.22609949 -2.08661215
      C  0.00000000 2.42010888 -0.01852722
      N  0.00000000 0.00000000 0.00000000
      H  0.00000000 3.35408071 -1.93647940
      H  0.00000000 0.00000000 3.87295880
      H  0.00000000 -3.35408071 -1.93647940
      H  0.00000000 -3.33344789 0.55006755
      H  0.00000000 1.19035147 -3.16188433
      H  0.00000000 2.14309642 2.61181678
      H  0.00000000 -2.14309642 2.61181678
      H  0.00000000 -1.19035147 -3.16188433
      H  0.00000000 3.33344789 0.55006755
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Cyclazine_PBE_ROKS_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
