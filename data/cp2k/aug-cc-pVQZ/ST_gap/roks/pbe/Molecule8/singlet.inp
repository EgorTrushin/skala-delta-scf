&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Molecule8_PBE_ROKS_TRIPLET-RESTART.wfn
    ROKS T
    MULTIPLICITY 3
    &LOW_SPIN_ROKS
      ! Variational singlet energy: 2 E(M) - E(T), at shared orbitals.
      ENERGY_SCALING -2 2
      SPIN_CONFIGURATION 1 1
      SPIN_CONFIGURATION 1 2
    &END LOW_SPIN_ROKS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 45
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &OT
        MINIMIZER DIIS
        STEPSIZE 0.005
        N_HISTORY_VEC 20
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 -1.19780590 0.69155356
      C  0.00000000 0.00000000 -1.38310713
      C  0.00000000 1.19780590 0.69155356
      C  0.00000000 -2.38509008 -0.06445907
      C  0.00000000 1.24836823 -2.03331907
      C  0.00000000 1.13672185 2.09777813
      C  0.00000000 -1.13672185 2.09777813
      C  0.00000000 -1.24836823 -2.03331907
      C  0.00000000 2.38509008 -0.06445907
      N  0.00000000 0.00000000 0.00000000
      N  0.00000000 -2.40950956 -1.39113100
      N  0.00000000 2.40950956 -1.39113100
      N  0.00000000 0.00000000 2.78226199
      H  0.00000000 -3.32443322 0.46377889
      H  0.00000000 1.26057231 -3.11093306
      H  0.00000000 2.06386091 2.64715417
      H  0.00000000 -2.06386091 2.64715417
      H  0.00000000 -1.26057231 -3.11093306
      H  0.00000000 3.32443322 0.46377889
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Molecule8_PBE_ROKS_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
