&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME ../../pbe/Molecule7/Molecule7_PBE_ROKS_GS-RESTART.wfn
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 49
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &MGGA_X_R2SCAN
        &END MGGA_X_R2SCAN
        &MGGA_C_R2SCAN
        &END MGGA_C_R2SCAN
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 1.36151349
      C  0.00000000 0.00000000 -2.79695309
      C  0.00000000 1.21086211 -0.70902588
      C  0.00000000 -1.21086211 -0.70902588
      C  0.00000000 1.24002346 2.02238140
      C  0.00000000 -1.24002346 2.02238140
      C  0.00000000 1.19982416 -2.11070895
      C  0.00000000 -1.19982416 -2.11070895
      C  0.00000000 2.38914551 0.06738520
      C  0.00000000 -2.38914551 0.06738520
      N  0.00000000 2.40757462 1.39188718
      N  0.00000000 0.00000000 -0.02741743
      N  0.00000000 -2.40757462 1.39188718
      H  0.00000000 0.00000000 -3.87486175
      H  0.00000000 1.23997499 3.10009435
      H  0.00000000 -1.23997499 3.10009435
      H  0.00000000 3.33248415 -0.45472331
      H  0.00000000 -3.33248415 -0.45472331
      H  0.00000000 2.14759574 -2.61946114
      H  0.00000000 -2.14759574 -2.61946114
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVQZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Molecule7_R2SCAN_ROKS_GS
  PRINT_LEVEL  MEDIUM
&END GLOBAL
