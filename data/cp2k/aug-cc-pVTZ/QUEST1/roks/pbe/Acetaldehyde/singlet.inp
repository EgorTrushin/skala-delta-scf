&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Acetaldehyde_PBE_ROKS_TRIPLET-RESTART.wfn
    ROKS T
    MULTIPLICITY 3
    &LOW_SPIN_ROKS
      ! Variational singlet energy: 2 E(M) - E(T), at shared orbitals.
      ENERGY_SCALING -2 2
      SPIN_CONFIGURATION 1 1
      SPIN_CONFIGURATION 1 2
    &END LOW_SPIN_ROKS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 13
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &OT
        MINIMIZER DIIS
        STEPSIZE 0.005
        N_HISTORY_VEC 20
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  -0.00124094 0.00000000 0.46104598
      C  -0.93054640 0.00000000 -0.71424991
      O  1.20624568 0.00000000 0.38083840
      H  -0.49162964 0.00000000 1.44957198
      H  -1.57671241 0.87868017 -0.66257994
      H  -1.57671241 -0.87868017 -0.66257994
      H  -0.37065389 0.00000000 -1.64609256
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND O
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Acetaldehyde_PBE_ROKS_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
