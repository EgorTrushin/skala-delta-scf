&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME ../../pbe/Molecule6/Molecule6_PBE_ROKS_SINGLET-RESTART.wfn
    ROKS T
    MULTIPLICITY 3
    &LOW_SPIN_ROKS
      ! Variational singlet energy: 2 E(M) - E(T), at shared orbitals.
      ENERGY_SCALING -2 2
      SPIN_CONFIGURATION 1 1
      SPIN_CONFIGURATION 1 2
    &END LOW_SPIN_ROKS
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 45
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &OT
        MINIMIZER DIIS
        STEPSIZE 0.005
        N_HISTORY_VEC 20
        PRECONDITIONER FULL_SINGLE_INVERSE
        ROTATION
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &MGGA_X_R2SCAN
        &END MGGA_X_R2SCAN
        &MGGA_C_R2SCAN
        &END MGGA_C_R2SCAN
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 1.42509133
      C  0.00000000 -1.20045651 -0.68336507
      C  0.00000000 1.20045651 -0.68336507
      C  0.00000000 -1.13079124 -2.09037019
      C  0.00000000 1.13079124 -2.09037019
      C  0.00000000 -2.41442704 0.01433303
      C  0.00000000 2.41442704 0.01433303
      C  0.00000000 -2.42236710 1.39554419
      C  0.00000000 2.42236710 1.39554419
      C  0.00000000 -1.23414159 2.09719521
      C  0.00000000 1.23414159 2.09719521
      N  0.00000000 0.00000000 0.02815927
      N  0.00000000 0.00000000 -2.78011921
      H  0.00000000 -2.06091618 -2.63567399
      H  0.00000000 2.06091618 -2.63567399
      H  0.00000000 -3.32203404 -0.56301461
      H  0.00000000 3.32203404 -0.56301461
      H  0.00000000 -3.35955052 1.92832424
      H  0.00000000 3.35955052 1.92832424
      H  0.00000000 -1.21110325 3.17283287
      H  0.00000000 1.21110325 3.17283287
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Molecule6_R2SCAN_ROKS_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
