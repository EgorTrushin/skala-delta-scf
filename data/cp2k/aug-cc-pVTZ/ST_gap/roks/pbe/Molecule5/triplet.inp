&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    ROKS T
    MULTIPLICITY 3
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 49
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS ATOMIC
      MAX_SCF 500
      ROKS_SCHEME HIGH-SPIN
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 1.42407627
      C  0.00000000 0.00000000 -2.57979181
      C  0.00000000 1.21920071 -0.67238241
      C  0.00000000 -1.21920071 -0.67238241
      C  0.00000000 2.37776163 1.29458642
      C  0.00000000 -2.37776163 1.29458642
      C  0.00000000 1.24206044 2.06657996
      C  0.00000000 -1.24206044 2.06657996
      N  0.00000000 0.00000000 0.04060732
      N  0.00000000 2.38678389 -0.04200336
      N  0.00000000 -2.38678389 -0.04200336
      N  0.00000000 1.19579934 -2.00864407
      N  0.00000000 -1.19579934 -2.00864407
      H  0.00000000 3.35036538 1.76492200
      H  0.00000000 -3.35036538 1.76492200
      H  0.00000000 1.27854085 3.14086407
      H  0.00000000 -1.27854085 3.14086407
      H  0.00000000 0.00000000 -3.65983049
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Molecule5_PBE_ROKS_TRIPLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
