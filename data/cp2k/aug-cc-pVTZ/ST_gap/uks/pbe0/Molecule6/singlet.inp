&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    AUTO_BASIS RI_HFX MEDIUM
    WFN_RESTART_FILE_NAME Molecule6_PBE0_GS-RESTART.wfn
    UKS T
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 49
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      CHOLESKY OFF
      EPS_EIGVAL 1e-6
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.1
      &END MIXING
      &MOM
         MOM_TYPE IMOM
         DEOCC_BETA 44
         OCC_BETA 45
      &END MOM
    &END SCF
    &XC
      &HF
        &SCREENING
          EPS_SCHWARZ 1.0E-10
        &END SCREENING
        &MEMORY
          MAX_MEMORY 2000
        &END MEMORY
        &RI T
          ! Diffuse (aug) functions make the RI basis ill-conditioned for the
          ! default Cholesky decomposition.
          2C_MATRIX_FUNCTIONS DIAG
          EPS_FILTER 1e-12
        &END RI
      &END HF
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 1.42509133
      C  0.00000000 -1.20045651 -0.68336507
      C  0.00000000 1.20045651 -0.68336507
      C  0.00000000 -1.13079124 -2.09037019
      C  0.00000000 1.13079124 -2.09037019
      C  0.00000000 -2.41442704 0.01433303
      C  0.00000000 2.41442704 0.01433303
      C  0.00000000 -2.42236710 1.39554419
      C  0.00000000 2.42236710 1.39554419
      C  0.00000000 -1.23414159 2.09719521
      C  0.00000000 1.23414159 2.09719521
      N  0.00000000 0.00000000 0.02815927
      N  0.00000000 0.00000000 -2.78011921
      H  0.00000000 -2.06091618 -2.63567399
      H  0.00000000 2.06091618 -2.63567399
      H  0.00000000 -3.32203404 -0.56301461
      H  0.00000000 3.32203404 -0.56301461
      H  0.00000000 -3.35955052 1.92832424
      H  0.00000000 3.35955052 1.92832424
      H  0.00000000 -1.21110325 3.17283287
      H  0.00000000 1.21110325 3.17283287
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Molecule6_PBE0_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
