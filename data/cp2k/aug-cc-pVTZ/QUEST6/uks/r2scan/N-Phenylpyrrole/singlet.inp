&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME N-Phenylpyrrole_R2SCAN_GS-RESTART.wfn
    UKS T
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 43
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &MOM
         MOM_TYPE IMOM
         DEOCC_BETA 38
         OCC_BETA 39
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &MGGA_X_R2SCAN
        &END MGGA_X_R2SCAN
        &MGGA_C_R2SCAN
        &END MGGA_C_R2SCAN
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 0.41546684
      C  1.20097522 0.00000000 1.12457214
      C  -1.20097522 0.00000000 1.12457214
      C  0.00000000 0.00000000 3.22006998
      C  1.19693826 0.00000000 2.51334200
      C  -1.19693826 0.00000000 2.51334200
      C  1.11756636 0.00000000 -1.80249433
      C  -1.11756636 0.00000000 -1.80249433
      C  0.71152105 0.00000000 -3.11029118
      C  -0.71152105 0.00000000 -3.11029118
      N  0.00000000 0.00000000 -0.99271586
      H  2.14067932 0.00000000 0.60243865
      H  -2.14067932 0.00000000 0.60243865
      H  2.13744596 0.00000000 3.03989269
      H  -2.13744596 0.00000000 3.03989269
      H  0.00000000 0.00000000 4.29695393
      H  2.10609279 0.00000000 -1.39370966
      H  -2.10609279 0.00000000 -1.39370966
      H  1.35995055 0.00000000 -3.96470975
      H  -1.35995055 0.00000000 -3.96470975
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      N-Phenylpyrrole_R2SCAN_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
