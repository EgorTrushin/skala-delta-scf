&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME ../../pbe/Twisted_DMABN/Twisted_DMABN_PBE_TRIPLET-RESTART.wfn
    UKS T
    MULTIPLICITY 3
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 -1
        &EACH
          QS_SCF 0
        &END EACH
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.1
      &END MIXING
      LEVEL_SHIFT 0.2
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MOM
         MOM_TYPE IMOM
         START_ITER 1
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &MGGA_X_R2SCAN
        &END MGGA_X_R2SCAN
        &MGGA_C_R2SCAN
        &END MGGA_C_R2SCAN
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 25.0 25.0 25.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 -1.01934887
      C  1.20242386 0.00000000 -0.30860536
      C  -1.20242386 0.00000000 -0.30860536
      C  0.00000000 0.00000000 1.77571050
      C  1.20827167 0.00000000 1.07821424
      C  -1.20827167 0.00000000 1.07821424
      C  0.00000000 0.00000000 3.20575088
      C  0.00000000 1.26574810 -3.11297688
      C  0.00000000 -1.26574810 -3.11297688
      N  0.00000000 0.00000000 -2.42593161
      N  0.00000000 0.00000000 4.36683775
      H  2.13140864 0.00000000 -0.85554472
      H  -2.13140864 0.00000000 -0.85554472
      H  2.13684006 0.00000000 1.62436878
      H  -2.13684006 0.00000000 1.62436878
      H  0.00000000 1.08617907 -4.18527979
      H  0.00000000 -1.08617907 -4.18527979
      H  0.88297409 1.86756840 -2.87668759
      H  -0.88297409 1.86756840 -2.87668759
      H  -0.88297409 -1.86756840 -2.87668759
      H  0.88297409 -1.86756840 -2.87668759
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Twisted_DMABN_R2SCAN_TRIPLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
