&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Dimethylaniline_R2SCAN_GS-RESTART.wfn
    UKS T
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 38
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &MOM
         MOM_TYPE IMOM
         DEOCC_BETA 33
         OCC_BETA 34
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &MGGA_X_R2SCAN
        &END MGGA_X_R2SCAN
        &MGGA_C_R2SCAN
        &END MGGA_C_R2SCAN
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 2.59131130
      C  1.19437570 0.00000000 1.87931183
      C  -1.19437570 0.00000000 1.87931183
      C  1.20341586 0.00000000 0.49129817
      C  -1.20341586 0.00000000 0.49129817
      C  0.00000000 0.00000000 -0.23598784
      C  1.24959519 0.00000000 -2.32665996
      C  -1.24959519 0.00000000 -2.32665996
      N  0.00000000 0.00000000 -1.60825836
      H  2.14804803 0.00000000 -0.02298998
      H  -2.14804803 0.00000000 -0.02298998
      H  2.13613345 0.00000000 2.40538502
      H  -2.13613345 0.00000000 2.40538502
      H  0.00000000 0.00000000 3.66801827
      H  1.04258710 0.00000000 -3.39201062
      H  -1.04258710 0.00000000 -3.39201062
      H  1.85106452 -0.88348965 -2.09853161
      H  1.85106452 0.88348965 -2.09853161
      H  -1.85106452 0.88348965 -2.09853161
      H  -1.85106452 -0.88348965 -2.09853161
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Dimethylaniline_R2SCAN_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
