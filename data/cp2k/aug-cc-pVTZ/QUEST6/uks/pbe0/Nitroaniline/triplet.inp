&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    AUTO_BASIS RI_HFX MEDIUM
    WFN_RESTART_FILE_NAME ../../pbe/Nitroaniline/Nitroaniline_PBE_TRIPLET-RESTART.wfn
    UKS T
    MULTIPLICITY 3
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 -1
        &EACH
          QS_SCF 0
        &END EACH
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &MOM
         MOM_TYPE IMOM
         START_ITER 1
      &END MOM
    &END SCF
    &XC
      &HF
        &SCREENING
          EPS_SCHWARZ 1.0E-10
        &END SCREENING
        &MEMORY
          MAX_MEMORY 2000
        &END MEMORY
        &RI T
          ! Diffuse (aug) functions make the RI basis ill-conditioned for the
          ! default Cholesky decomposition.
          2C_MATRIX_FUNCTIONS DIAG
        &END RI
      &END HF
      &XC_FUNCTIONAL PBE0
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 -2.14801358
      C  1.20688574 0.00000000 -1.43307045
      C  -1.20688574 0.00000000 -1.43307045
      C  0.00000000 0.00000000 0.63048331
      C  1.20815565 0.00000000 -0.05123411
      C  -1.20815565 0.00000000 -0.05123411
      N  0.00000000 0.00000000 2.08523739
      N  0.00000000 0.00000000 -3.51236894
      O  1.08453908 0.00000000 2.65335167
      O  -1.08453908 0.00000000 2.65335167
      H  2.14210473 0.00000000 -1.96957121
      H  -2.14210473 0.00000000 -1.96957121
      H  2.12746468 0.00000000 0.50566732
      H  -2.12746468 0.00000000 0.50566732
      H  -0.85796734 0.00000000 -4.02433332
      H  0.85796734 0.00000000 -4.02433332
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND O
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Nitroaniline_PBE0_TRIPLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
