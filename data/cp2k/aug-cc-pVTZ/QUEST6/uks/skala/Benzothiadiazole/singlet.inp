&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Benzothiadiazole_SKALA_GS-RESTART.wfn
    UKS T
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 40
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.1
      &END MIXING
      &MOM
         MOM_TYPE IMOM
         DEOCC_BETA 35
         OCC_BETA 36
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          SKALA_RUNTIME MPI
          INT_EXECUTION_SPACE HOST
          GRID FINE
          PRUNING_SCHEME ROBUST
          RADIAL_QUADRATURE MURAKNOWLES
          MODEL_ATOM_CHUNK_SIZE 1
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      S  0.00000000 0.00000000 2.18435019
      N  0.00000000 1.25941513 1.14722924
      N  0.00000000 -1.25941513 1.14722924
      C  0.00000000 0.71684770 -0.07985743
      C  0.00000000 -0.71684770 -0.07985743
      C  0.00000000 1.43200021 -1.30495026
      C  0.00000000 -1.43200021 -1.30495026
      C  0.00000000 0.71420165 -2.46823996
      C  0.00000000 -0.71420165 -2.46823996
      H  0.00000000 2.50857126 -1.29635924
      H  0.00000000 -2.50857126 -1.29635924
      H  0.00000000 1.23108256 -3.41404520
      H  0.00000000 -1.23108256 -3.41404520
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND S
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Benzothiadiazole_SKALA_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
