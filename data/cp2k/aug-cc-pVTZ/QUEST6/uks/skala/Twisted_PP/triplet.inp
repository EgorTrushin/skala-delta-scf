&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME ../../pbe/Twisted_PP/Twisted_PP_PBE_TRIPLET-RESTART.wfn
    UKS T
    MULTIPLICITY 3
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 -1
        &EACH
          QS_SCF 0
        &END EACH
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-7
      SCF_GUESS RESTART
      MAX_SCF 800
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.1
      &END MIXING
      LEVEL_SHIFT 0.0
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MOM
         MOM_TYPE IMOM
         START_ITER 1
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          SKALA_RUNTIME MPI
          INT_EXECUTION_SPACE HOST
          GRID FINE
          PRUNING_SCHEME ROBUST
          RADIAL_QUADRATURE MURAKNOWLES
          MODEL_ATOM_CHUNK_SIZE 1
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 0.42520295
      C  1.20691269 0.00000000 1.11559386
      C  -1.20691269 0.00000000 1.11559386
      C  0.00000000 0.00000000 3.20200384
      C  1.20510563 0.00000000 2.50609515
      C  -1.20510563 0.00000000 2.50609515
      C  0.00000000 1.11918911 -1.78961365
      C  0.00000000 -1.11918911 -1.78961365
      C  0.00000000 0.71050199 -3.10225163
      C  0.00000000 -0.71050199 -3.10225163
      N  0.00000000 0.00000000 -0.99387318
      H  2.13024571 0.00000000 0.55987826
      H  -2.13024571 0.00000000 0.55987826
      H  2.13954933 0.00000000 3.04289276
      H  -2.13954933 0.00000000 3.04289276
      H  0.00000000 0.00000000 4.27947025
      H  0.00000000 2.09711395 -1.34938059
      H  0.00000000 -2.09711395 -1.34938059
      H  0.00000000 1.35598096 -3.95900813
      H  0.00000000 -1.35598096 -3.95900813
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Twisted_PP_SKALA_TRIPLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
