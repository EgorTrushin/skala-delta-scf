&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME ../../pbe/Aminobenzonitrile/Aminobenzonitrile_PBE_TRIPLET-RESTART.wfn
    UKS T
    MULTIPLICITY 3
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 -1
        &EACH
          QS_SCF 0
        &END EACH
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &MOM
         MOM_TYPE IMOM
         START_ITER 1
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          SKALA_RUNTIME MPI
          INT_EXECUTION_SPACE HOST
          GRID FINE
          PRUNING_SCHEME ROBUST
          RADIAL_QUADRATURE MURAKNOWLES
          MODEL_ATOM_CHUNK_SIZE 1
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 -1.78237803
      C  1.20562318 0.00000000 -1.06602913
      C  -1.20562318 0.00000000 -1.06602913
      C  0.00000000 0.00000000 1.02612499
      C  1.20309056 0.00000000 0.31620347
      C  -1.20309056 0.00000000 0.31620347
      C  0.00000000 0.00000000 2.45145106
      N  0.00000000 0.00000000 -3.14791690
      N  0.00000000 0.00000000 3.61459851
      H  2.14197992 0.00000000 -1.60135147
      H  -2.14197992 0.00000000 -1.60135147
      H  2.13631189 0.00000000 0.85489503
      H  -2.13631189 0.00000000 0.85489503
      H  -0.85820433 0.00000000 -3.65983307
      H  0.85820433 0.00000000 -3.65983307
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Aminobenzonitrile_SKALA_TRIPLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
