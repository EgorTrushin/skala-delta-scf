&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME ../../pbe/Nitroaniline/Nitroaniline_PBE_TRIPLET-RESTART.wfn
    UKS T
    MULTIPLICITY 3
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 -1
        &EACH
          QS_SCF 0
        &END EACH
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.1
      &END MIXING
      LEVEL_SHIFT 0.2
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MOM
         MOM_TYPE IMOM
         START_ITER 1
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          SKALA_RUNTIME MPI
          INT_EXECUTION_SPACE HOST
          GRID FINE
          PRUNING_SCHEME ROBUST
          RADIAL_QUADRATURE MURAKNOWLES
          MODEL_ATOM_CHUNK_SIZE 1
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 -2.14801358
      C  1.20688574 0.00000000 -1.43307045
      C  -1.20688574 0.00000000 -1.43307045
      C  0.00000000 0.00000000 0.63048331
      C  1.20815565 0.00000000 -0.05123411
      C  -1.20815565 0.00000000 -0.05123411
      N  0.00000000 0.00000000 2.08523739
      N  0.00000000 0.00000000 -3.51236894
      O  1.08453908 0.00000000 2.65335167
      O  -1.08453908 0.00000000 2.65335167
      H  2.14210473 0.00000000 -1.96957121
      H  -2.14210473 0.00000000 -1.96957121
      H  2.12746468 0.00000000 0.50566732
      H  -2.12746468 0.00000000 0.50566732
      H  -0.85796734 0.00000000 -4.02433332
      H  0.85796734 0.00000000 -4.02433332
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND O
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Nitroaniline_SKALA_TRIPLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
