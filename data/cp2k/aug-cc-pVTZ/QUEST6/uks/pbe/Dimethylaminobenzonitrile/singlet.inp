&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Dimethylaminobenzonitrile_PBE_GS-RESTART.wfn
    UKS T
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 44
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.1
      &END MIXING
      &MOM
         MOM_TYPE IMOM
         DEOCC_BETA 39
         OCC_BETA 40
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 -1.03762759
      C  1.20594890 0.00000000 -0.30848248
      C  -1.20594890 0.00000000 -0.30848248
      C  0.00000000 0.00000000 1.78562909
      C  1.19970319 0.00000000 1.07319129
      C  -1.19970319 0.00000000 1.07319129
      C  0.00000000 0.00000000 3.21104090
      C  1.25142566 0.00000000 -3.12313457
      C  -1.25142566 0.00000000 -3.12313457
      N  0.00000000 0.00000000 -2.40105295
      N  0.00000000 0.00000000 4.37303050
      H  2.15094350 0.00000000 -0.82077279
      H  -2.15094350 0.00000000 -0.82077279
      H  2.13453785 0.00000000 1.60922778
      H  -2.13453785 0.00000000 1.60922778
      H  1.04161449 0.00000000 -4.18734140
      H  -1.04161449 0.00000000 -4.18734140
      H  1.84974516 -0.88431708 -2.89461761
      H  1.84974516 0.88431708 -2.89461761
      H  -1.84974516 0.88431708 -2.89461761
      H  -1.84974516 -0.88431708 -2.89461761
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Dimethylaminobenzonitrile_PBE_SINGLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
