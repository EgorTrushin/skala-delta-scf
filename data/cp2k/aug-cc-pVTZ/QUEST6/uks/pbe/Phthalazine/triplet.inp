&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME Phthalazine_PBE_TRIPLET_GUESS.wfn
    UKS T
    MULTIPLICITY 3
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 -1
        &EACH
          QS_SCF 0
        &END EACH
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS RESTART
      MAX_SCF 500
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.1
      &END MIXING
      LEVEL_SHIFT 0.2
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
      &MOM
         MOM_TYPE IMOM
         START_ITER 1
      &END MOM
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.70094519 -0.03774450
      C  0.00000000 -0.70094519 -0.03774450
      C  0.00000000 1.40489400 -1.25781726
      C  0.00000000 -1.40489400 -1.25781726
      C  0.00000000 0.70650722 -2.44237044
      C  0.00000000 -0.70650722 -2.44237044
      C  0.00000000 1.32191744 1.23728687
      C  0.00000000 -1.32191744 1.23728687
      N  0.00000000 0.68568306 2.38220076
      N  0.00000000 -0.68568306 2.38220076
      H  0.00000000 2.48400773 -1.25016518
      H  0.00000000 -2.48400773 -1.25016518
      H  0.00000000 1.23583294 -3.38115273
      H  0.00000000 -1.23583294 -3.38115273
      H  0.00000000 2.40174044 1.30694165
      H  0.00000000 -2.40174044 1.30694165
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Phthalazine_PBE_TRIPLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
