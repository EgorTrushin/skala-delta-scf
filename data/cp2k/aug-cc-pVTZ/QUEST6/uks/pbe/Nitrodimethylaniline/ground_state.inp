&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 49
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS ATOMIC
      MAX_SCF 500
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 20.0 20.0 20.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 -1.43350797
      C  1.20804219 0.00000000 -0.70539471
      C  -1.20804219 0.00000000 -0.70539471
      C  0.00000000 0.00000000 1.36107752
      C  1.20557908 0.00000000 0.67628100
      C  -1.20557908 0.00000000 0.67628100
      C  1.25152635 0.00000000 -3.51873760
      C  -1.25152635 0.00000000 -3.51873760
      N  0.00000000 0.00000000 -2.79572246
      N  0.00000000 0.00000000 2.81443952
      O  1.08458905 0.00000000 3.38335219
      O  -1.08458905 0.00000000 3.38335219
      H  2.15207548 0.00000000 -1.21907713
      H  -2.15207548 0.00000000 -1.21907713
      H  2.12679902 0.00000000 1.23060782
      H  -2.12679902 0.00000000 1.23060782
      H  1.04101752 0.00000000 -4.58274442
      H  -1.04101752 0.00000000 -4.58274442
      H  1.84946540 -0.88435072 -3.29010255
      H  1.84946540 0.88435072 -3.29010255
      H  -1.84946540 0.88435072 -3.29010255
      H  -1.84946540 -0.88435072 -3.29010255
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND O
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Nitrodimethylaniline_PBE_GS
  PRINT_LEVEL  MEDIUM
&END GLOBAL
