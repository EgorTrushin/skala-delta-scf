&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_def2_QZVP_RI_ALL
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME seed.wfn
    UKS T
    MULTIPLICITY 3
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &AO_MATRICES ON
        FILENAME =density.Log
        NDIGITS 16
        DENSITY T
        &EACH
          QS_SCF 1
        &END EACH
      &END AO_MATRICES
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      SCF_GUESS RESTART
      MAX_SCF 1
      EPS_SCF 1.0E-30
      &OT
        MINIMIZER CG
        PRECONDITIONER NONE
        STEPSIZE 0.001
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 -1.19780590 0.69155356
      C  0.00000000 0.00000000 -1.38310713
      C  0.00000000 1.19780590 0.69155356
      C  0.00000000 -2.38509008 -0.06445907
      C  0.00000000 1.24836823 -2.03331907
      C  0.00000000 1.13672185 2.09777813
      C  0.00000000 -1.13672185 2.09777813
      C  0.00000000 -1.24836823 -2.03331907
      C  0.00000000 2.38509008 -0.06445907
      N  0.00000000 0.00000000 0.00000000
      N  0.00000000 -2.40950956 -1.39113100
      N  0.00000000 2.40950956 -1.39113100
      N  0.00000000 0.00000000 2.78226199
      H  0.00000000 -3.32443322 0.46377889
      H  0.00000000 1.26057231 -3.11093306
      H  0.00000000 2.06386091 2.64715417
      H  0.00000000 -2.06386091 2.64715417
      H  0.00000000 -1.26057231 -3.11093306
      H  0.00000000 3.32443322 0.46377889
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT frozen
  PRINT_LEVEL  MEDIUM
&END GLOBAL
