&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_def2_QZVP_RI_ALL
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME seed.wfn
    UKS T
    MULTIPLICITY 1
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &AO_MATRICES ON
        FILENAME =density.Log
        NDIGITS 16
        DENSITY T
        &EACH
          QS_SCF 1
        &END EACH
      &END AO_MATRICES
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      SCF_GUESS RESTART
      MAX_SCF 1
      EPS_SCF 1.0E-30
      &OT
        MINIMIZER CG
        PRECONDITIONER NONE
        STEPSIZE 0.001
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 -1.21509585 0.70153592
      C  0.00000000 -2.42035519 -1.39739272
      C  0.00000000 0.00000000 -1.40307183
      C  0.00000000 2.42035519 -1.39739272
      C  0.00000000 1.21509585 0.70153592
      C  0.00000000 0.00000000 2.79478544
      C  0.00000000 -2.42010888 -0.01852722
      C  0.00000000 1.22609949 -2.08661215
      C  0.00000000 1.19400939 2.10513938
      C  0.00000000 -1.19400939 2.10513938
      C  0.00000000 -1.22609949 -2.08661215
      C  0.00000000 2.42010888 -0.01852722
      N  0.00000000 0.00000000 0.00000000
      H  0.00000000 3.35408071 -1.93647940
      H  0.00000000 0.00000000 3.87295880
      H  0.00000000 -3.35408071 -1.93647940
      H  0.00000000 -3.33344789 0.55006755
      H  0.00000000 1.19035147 -3.16188433
      H  0.00000000 2.14309642 2.61181678
      H  0.00000000 -2.14309642 2.61181678
      H  0.00000000 -1.19035147 -3.16188433
      H  0.00000000 3.33344789 0.55006755
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT frozen
  PRINT_LEVEL  MEDIUM
&END GLOBAL
