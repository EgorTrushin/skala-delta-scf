&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_def2_QZVP_RI_ALL
    POTENTIAL_FILE_NAME POTENTIAL
    ROKS T
    MULTIPLICITY 3
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &MO
        EIGENVALUES
        MO_RANGE 1 49
      &END MO
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      EPS_SCF 1.0E-5
      SCF_GUESS ATOMIC
      MAX_SCF 500
      &MIXING
        METHOD DIRECT_P_MIXING
        ALPHA 0.1
      &END MIXING
      LEVEL_SHIFT 0.2
      ROKS_SCHEME HIGH-SPIN
      &DIAGONALIZATION
        ALGORITHM STANDARD
      &END DIAGONALIZATION
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 -1.21026832 0.69874874
      C  0.00000000 -2.25409077 -1.30139992
      C  0.00000000 0.00000000 -1.39749748
      C  0.00000000 2.25409077 -1.30139992
      C  0.00000000 1.21026832 0.69874874
      C  0.00000000 0.00000000 2.60279983
      N  0.00000000 0.00000000 0.00000000
      N  0.00000000 -2.35681119 0.02353328
      N  0.00000000 1.15802518 -2.05282500
      N  0.00000000 1.19878601 2.02929172
      N  0.00000000 -1.19878601 2.02929172
      N  0.00000000 -1.15802518 -2.05282500
      N  0.00000000 2.35681119 0.02353328
      H  0.00000000 3.18888962 -1.84110628
      H  0.00000000 0.00000000 3.68221256
      H  0.00000000 -3.18888962 -1.84110628
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT      Heptazine_PBE_ROKS_TRIPLET
  PRINT_LEVEL  MEDIUM
&END GLOBAL
