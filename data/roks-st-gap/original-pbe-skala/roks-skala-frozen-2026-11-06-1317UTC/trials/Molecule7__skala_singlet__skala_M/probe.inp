&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_def2_QZVP_RI_ALL
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME seed.wfn
    UKS T
    MULTIPLICITY 1
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &AO_MATRICES ON
        FILENAME =density.Log
        NDIGITS 16
        DENSITY T
        &EACH
          QS_SCF 1
        &END EACH
      &END AO_MATRICES
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      SCF_GUESS RESTART
      MAX_SCF 1
      EPS_SCF 1.0E-30
      &OT
        MINIMIZER CG
        PRECONDITIONER NONE
        STEPSIZE 0.001
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &GAUXC
          MODEL SKALA
          SKALA_RUNTIME MPI
          INT_EXECUTION_SPACE HOST
          GRID FINE
          PRUNING_SCHEME ROBUST
          RADIAL_QUADRATURE MURAKNOWLES
          MODEL_ATOM_CHUNK_SIZE 1
        &END GAUXC
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 1.36151349
      C  0.00000000 0.00000000 -2.79695309
      C  0.00000000 1.21086211 -0.70902588
      C  0.00000000 -1.21086211 -0.70902588
      C  0.00000000 1.24002346 2.02238140
      C  0.00000000 -1.24002346 2.02238140
      C  0.00000000 1.19982416 -2.11070895
      C  0.00000000 -1.19982416 -2.11070895
      C  0.00000000 2.38914551 0.06738520
      C  0.00000000 -2.38914551 0.06738520
      N  0.00000000 2.40757462 1.39188718
      N  0.00000000 0.00000000 -0.02741743
      N  0.00000000 -2.40757462 1.39188718
      H  0.00000000 0.00000000 -3.87486175
      H  0.00000000 1.23997499 3.10009435
      H  0.00000000 -1.23997499 3.10009435
      H  0.00000000 3.33248415 -0.45472331
      H  0.00000000 -3.33248415 -0.45472331
      H  0.00000000 2.14759574 -2.61946114
      H  0.00000000 -2.14759574 -2.61946114
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT frozen
  PRINT_LEVEL  MEDIUM
&END GLOBAL
