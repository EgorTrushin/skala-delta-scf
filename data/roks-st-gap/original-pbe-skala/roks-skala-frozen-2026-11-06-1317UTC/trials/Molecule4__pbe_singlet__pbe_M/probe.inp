&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    BASIS_SET_FILE_NAME BASIS_def2_QZVP_RI_ALL
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME seed.wfn
    UKS T
    MULTIPLICITY 1
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &AO_MATRICES ON
        FILENAME =density.Log
        NDIGITS 16
        DENSITY T
        &EACH
          QS_SCF 1
        &END EACH
      &END AO_MATRICES
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      SCF_GUESS RESTART
      MAX_SCF 1
      EPS_SCF 1.0E-30
      &OT
        MINIMIZER CG
        PRECONDITIONER NONE
        STEPSIZE 0.001
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 1.39188565
      C  0.00000000 0.00000000 -2.76599417
      C  0.00000000 -1.21792388 -0.69273656
      C  0.00000000 1.21792388 -0.69273656
      C  0.00000000 -1.20313869 -2.08296814
      C  0.00000000 1.20313869 -2.08296814
      C  0.00000000 -2.26567732 1.30886150
      C  0.00000000 2.26567732 1.30886150
      N  0.00000000 0.00000000 -0.01940584
      N  0.00000000 -2.37860356 -0.00383217
      N  0.00000000 2.37860356 -0.00383217
      N  0.00000000 -1.15425058 2.04921522
      N  0.00000000 1.15425058 2.04921522
      H  0.00000000 -2.15517594 -2.58041621
      H  0.00000000 2.15517594 -2.58041621
      H  0.00000000 -3.19217490 1.86393056
      H  0.00000000 3.19217490 1.86393056
      H  0.00000000 0.00000000 -3.84375807
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      BASIS_SET RI_AUX RI-5Z
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT frozen
  PRINT_LEVEL  MEDIUM
&END GLOBAL
