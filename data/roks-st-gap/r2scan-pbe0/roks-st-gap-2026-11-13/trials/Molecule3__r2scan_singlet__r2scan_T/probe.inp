&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL
    WFN_RESTART_FILE_NAME seed.wfn
    UKS T
    MULTIPLICITY 3
    &MGRID
      CUTOFF 400
      REL_CUTOFF 50
    &END MGRID
    &PRINT
      &AO_MATRICES ON
        FILENAME =density.Log
        NDIGITS 16
        DENSITY T
        &EACH
          QS_SCF 1
        &END EACH
      &END AO_MATRICES
    &END PRINT
    &QS
      METHOD GAPW
    &END QS
    &POISSON
      PERIODIC NONE
      PSOLVER MT
    &END
    &SCF
      SCF_GUESS RESTART
      MAX_SCF 1
      EPS_SCF 1.0E-30
      &OT
        MINIMIZER CG
        PRECONDITIONER NONE
        STEPSIZE 0.001
      &END OT
    &END SCF
    &XC
      &XC_FUNCTIONAL
        &MGGA_X_R2SCAN
        &END MGGA_X_R2SCAN
        &MGGA_C_R2SCAN
        &END MGGA_C_R2SCAN
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC 15.0 15.0 15.0
      PERIODIC NONE
    &END CELL
    &COORD
      C  0.00000000 0.00000000 1.39197209
      C  0.00000000 0.00000000 -2.81819844
      C  0.00000000 -1.20807198 -0.73030140
      C  0.00000000 1.20807198 -0.73030140
      C  0.00000000 -1.19577757 -2.12771804
      C  0.00000000 1.19577757 -2.12771804
      C  0.00000000 -2.38848636 0.03097298
      C  0.00000000 2.38848636 0.03097298
      C  0.00000000 -2.29247322 1.39687425
      C  0.00000000 2.29247322 1.39687425
      N  0.00000000 0.00000000 -0.03851664
      N  0.00000000 -1.14303830 2.07622658
      N  0.00000000 1.14303830 2.07622658
      H  0.00000000 -2.14477126 -2.63458714
      H  0.00000000 2.14477126 -2.63458714
      H  0.00000000 -3.33500240 -0.47876914
      H  0.00000000 3.33500240 -0.47876914
      H  0.00000000 -3.18883250 2.00087543
      H  0.00000000 3.18883250 2.00087543
      H  0.00000000 0.00000000 -3.89604928
    &END COORD
    &TOPOLOGY
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY
    &KIND C
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND H
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
    &KIND N
      BASIS_SET aug-cc-pVTZ
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&GLOBAL
  RUN_TYPE     ENERGY
  PROJECT frozen
  PRINT_LEVEL  MEDIUM
&END GLOBAL
